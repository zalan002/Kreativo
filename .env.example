# Kreativo — szerveroldali környezeti változók (Vercel project settings → Environment Variables)
# Ezeket SOHA ne commitold éles értékkel — ez a fájl csak sablon.

# ── Meta Conversions API (api/capi.js + api/lead.js) ──
# A Meta Pixel ID — a böngészőben is látható, nem titkos.
FB_PIXEL_ID=
# Conversions API access token — TITKOS, csak szerver oldalon.
FB_CAPI_TOKEN=
# Opcionális: Events Manager → Test Events kód. Prodban hagyd ÜRESEN,
# különben az események nem konverziónak számítanak.
META_TEST_EVENT_CODE=

# ── n8n lead webhook (api/lead.js) ──
# A lead routing webhook URL-je. Prodban KÖTELEZŐ — ha nincs beállítva,
# a /api/lead 503-at ad (dev környezetben devMode válasszal átengedi).
# Vercelen Production és Preview scope-ban külön értékkel állítható
# (prod webhook URL, illetve n8n teszt webhook URL).
N8N_EBOOK_WEBHOOK_URL=
# Opcionális: ha beállítod, "Authorization: Bearer <secret>" headerrel megy az n8n felé.
N8N_EBOOK_WEBHOOK_SECRET=

# ── E-mail értesítés a leadekről (api/lead.js, nodemailer SMTP) ──
# SMTP kapcsolat — Mandrill. A jelszó TITKOS, soha ne kerüljön git-be.
SMTP_HOST=smtp.mandrillapp.com
SMTP_PORT=587
SMTP_USER=Training Hungary Kft.
SMTP_PASS=
# Feladó cím — Mandrillban visszaigazolt küldő domain ajánlott.
LEAD_EMAIL_FROM=info@kreativo.hu
# Címzettek vesszővel elválasztva. Ha üresen hagyod:
#   - Production scope-ban  → info@kreativo.hu,zalan@traininghungary.com
#   - egyéb (Preview/teszt) → zalan@traininghungary.com
# Vercelen Production és Preview scope-ban külön értékkel is állítható.
LEAD_EMAIL_TO=
