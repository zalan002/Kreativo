# Kreativo — szerveroldali környezeti változók (Vercel project settings → Environment Variables)
# Ezeket SOHA ne commitold éles értékkel — ez a fájl csak sablon.

# ── Meta Conversions API (api/capi.js + api/lead.js) ──
# A Meta Pixel ID — a böngészőben is látható, nem titkos.
FB_PIXEL_ID=
# Conversions API access token — TITKOS, csak szerver oldalon.
FB_CAPI_TOKEN=
# Opcionális: Events Manager → Test Events kód. Prodban hagyd ÜRESEN,
# különben az események nem konverziónak számítanak.
META_TEST_EVENT_CODE=

# ── n8n lead webhook (api/lead.js) ──
# A lead routing webhook URL-je. Prodban kötelező; ha üres, a kód a
# korábban használt hardcode-olt URL-re esik vissza.
N8N_EBOOK_WEBHOOK_URL=
# Opcionális: ha beállítod, "Authorization: Bearer <secret>" headerrel megy az n8n felé.
N8N_EBOOK_WEBHOOK_SECRET=
